{% comment %}
  ============================================================================
  PURELANE — BUNDLES TIERS SECTION
  ============================================================================
  "Build your bundle" — 3 pricing tiers with product image row.
  Each tier is a merchant-editable block with product pickers, price,
  benefit checklist, and CTA.
{% endcomment %}

{{ 'purelane-bundles.css' | asset_url | stylesheet_tag }}
<script src="{{ 'purelane-animations.js' | asset_url }}" defer></script>

{%- liquid
  assign kicker = section.settings.kicker
  assign heading = section.settings.heading
  assign lede = section.settings.lede
  assign tier_blocks = section.blocks
-%}

<section
  id="bundles"
  class="pl-section pl-bundles"
  aria-labelledby="pl-bundles-heading"
>
  <div class="pl-wrap">

    {%- if kicker != blank or heading != blank or lede != blank -%}
      <div class="pl-glass pl-sec-pad pl-bundles-intro pl-rv">
        <div class="pl-panel-head">
          {%- if kicker != blank -%}
            <span class="pl-kicker">{{ kicker }}</span>
          {%- endif -%}
          {%- if heading != blank -%}
            <h2 class="pl-d2" id="pl-bundles-heading" style="margin-top: 12px;">{{ heading }}</h2>
          {%- endif -%}
          {%- if lede != blank -%}
            <p class="pl-lede">{{ lede }}</p>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}

    {%- if tier_blocks.size > 0 -%}
      <div class="pl-tiers" role="list" aria-label="Bundle tiers">
        {%- for block in tier_blocks -%}
          {%- liquid
            assign product_count = 0
            if block.settings.product_1 != blank
              assign product_count = product_count | plus: 1
            endif
            if block.settings.product_2 != blank
              assign product_count = product_count | plus: 1
            endif
            if block.settings.product_3 != blank
              assign product_count = product_count | plus: 1
            endif
            if block.settings.product_4 != blank
              assign product_count = product_count | plus: 1
            endif
            if block.settings.product_5 != blank
              assign product_count = product_count | plus: 1
            endif

            assign card_classes = 'pl-glass pl-tier'
            if block.settings.is_best
              assign card_classes = card_classes | append: ' pl-tier--best'
            endif

            assign pix_classes = 'pl-tierpix'
            if product_count >= 5
              assign pix_classes = pix_classes | append: ' pl-tierpix--five'
            endif
          -%}

          {%- capture reveal_delay -%}
            {%- if forloop.index0 == 1 -%}pl-rv-d2{%- endif -%}
            {%- if forloop.index0 == 2 -%}pl-rv-d3{%- endif -%}
          {%- endcapture -%}

          <article
            class="{{ card_classes }} pl-rv {{ reveal_delay | strip }}"
            role="listitem"
            {{ block.shopify_attributes }}
          >
            {%- if block.settings.tag != blank -%}
              <span class="pl-tier-tag">{{ block.settings.tag }}</span>
            {%- endif -%}

            {%- if product_count > 0 -%}
              <div class="{{ pix_classes }}" aria-hidden="true">
                {%- for i in (1..5) -%}
                  {%- assign p = 'product_' | append: i -%}
                  {%- assign this_product = block.settings[p] -%}
                  {%- if this_product != blank and this_product.featured_image != blank -%}
                    <img
                      src="{{ this_product.featured_image | image_url: width: 160 }}"
                      srcset="
                        {{ this_product.featured_image | image_url: width: 120 }} 120w,
                        {{ this_product.featured_image | image_url: width: 240 }} 240w
                      "
                      sizes="62px"
                      width="{{ this_product.featured_image.width }}"
                      height="{{ this_product.featured_image.height }}"
                      alt="{{ this_product.featured_image.alt | default: this_product.title | escape }}"
                      loading="lazy"
                    >
                  {%- endif -%}
                {%- endfor -%}
              </div>
            {%- endif -%}

            {%- if block.settings.qty != blank -%}
              <div class="pl-tier-qty">
                {{ block.settings.qty }}
                {%- if block.settings.qty_label != blank -%}
                  <small>{{ block.settings.qty_label }}</small>
                {%- endif -%}
              </div>
            {%- endif -%}

            {%- if block.settings.price != blank -%}
              <div class="pl-tier-price">
                {{ block.settings.price }}
                {%- if block.settings.compare_price != blank -%}
                  <s>{{ block.settings.compare_price }}</s>
                {%- endif -%}
              </div>
            {%- endif -%}

            {%- if block.settings.per_unit != blank -%}
              <p class="pl-tier-per">{{ block.settings.per_unit }}</p>
            {%- endif -%}

            {%- if block.settings.benefits != blank -%}
              <ul class="pl-tier-list">
                {%- assign benefit_items = block.settings.benefits | newline_to_br | split: '<br />' -%}
                {%- for item in benefit_items -%}
                  {%- assign clean_item = item | strip -%}
                  {%- if clean_item != blank -%}
                    <li>
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="m5 13 4 4L19 7"/>
                      </svg>
                      {{ clean_item }}
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            {%- endif -%}

            {%- if block.settings.cta_label != blank -%}
              {%- assign btn_class = 'pl-btn pl-btn-ghost' -%}
              {%- if block.settings.is_best -%}
                {%- assign btn_class = 'pl-btn pl-btn-primary' -%}
              {%- endif -%}
              <a class="{{ btn_class }}" href="{{ block.settings.cta_url | default: '#' }}">
                {{ block.settings.cta_label }}
                {%- if block.settings.is_best -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M5 12h13m-5-6 6 6-6 6"/>
                  </svg>
                {%- endif -%}
              </a>
            {%- endif -%}
          </article>
        {%- endfor -%}
      </div>
    {%- else -%}
      <div style="text-align: center; padding: 40px; color: var(--pl-paper-3);">
        <p style="font-size: 14px;">Add tier blocks in the section settings to display them here.</p>
      </div>
    {%- endif -%}

  </div>
</section>

{% schema %}
{
  "name": "Purelane Bundles",
  "tag": "section",
  "class": "pl-bundles-wrap",
  "settings": [
    {
      "type": "header",
      "content": "Header"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker label",
      "default": "Build your bundle"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "One box. Every room."
    },
    {
      "type": "textarea",
      "id": "lede",
      "label": "Intro text",
      "default": "Mix and match across kitchen, laundry, home and skin. One flat price, no code needed, free shipping either way."
    }
  ],
  "blocks": [
    {
      "type": "tier",
      "name": "Tier",
      "limit": 4,
      "settings": [
        {
          "type": "header",
          "content": "Label"
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Tag label",
          "default": "Starter"
        },
        {
          "type": "checkbox",
          "id": "is_best",
          "label": "Highlight as best value (featured styling + primary CTA)",
          "default": false
        },
        {
          "type": "header",
          "content": "Quantity"
        },
        {
          "type": "text",
          "id": "qty",
          "label": "Quantity number",
          "default": "2"
        },
        {
          "type": "text",
          "id": "qty_label",
          "label": "Quantity label",
          "default": "Products"
        },
        {
          "type": "header",
          "content": "Pricing"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price",
          "default": "₹349"
        },
        {
          "type": "text",
          "id": "compare_price",
          "label": "Compare-at price",
          "default": "₹598"
        },
        {
          "type": "text",
          "id": "per_unit",
          "label": "Per-unit line",
          "default": "Flat ₹174 per product"
        },
        {
          "type": "header",
          "content": "Products (image row)"
        },
        {
          "type": "product",
          "id": "product_1",
          "label": "Product 1"
        },
        {
          "type": "product",
          "id": "product_2",
          "label": "Product 2"
        },
        {
          "type": "product",
          "id": "product_3",
          "label": "Product 3"
        },
        {
          "type": "product",
          "id": "product_4",
          "label": "Product 4"
        },
        {
          "type": "product",
          "id": "product_5",
          "label": "Product 5"
        },
        {
          "type": "header",
          "content": "Benefits (checklist)"
        },
        {
          "type": "textarea",
          "id": "benefits",
          "label": "One benefit per line",
          "default": "Pick any two products\nFree shipping across India"
        },
        {
          "type": "header",
          "content": "CTA"
        },
        {
          "type": "text",
          "id": "cta_label",
          "label": "Button label",
          "default": "Build this box"
        },
        {
          "type": "url",
          "id": "cta_url",
          "label": "Button link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane Bundles",
      "blocks": [
        {
          "type": "tier",
          "settings": {
            "tag": "Starter",
            "qty": "2",
            "qty_label": "Products",
            "price": "₹349",
            "compare_price": "₹598",
            "per_unit": "Flat ₹174 per product",
            "benefits": "Pick any two products\nFree shipping across India",
            "cta_label": "Build this box"
          }
        },
        {
          "type": "tier",
          "settings": {
            "tag": "Most popular",
            "is_best": true,
            "qty": "3",
            "qty_label": "Products",
            "price": "₹499",
            "compare_price": "₹897",
            "per_unit": "Flat ₹166 per product",
            "benefits": "Pick any three products\nCovers kitchen and laundry\nFree shipping across India",
            "cta_label": "Build this box"
          }
        },
        {
          "type": "tier",
          "settings": {
            "tag": "Whole home",
            "qty": "5",
            "qty_label": "Products",
            "price": "₹799",
            "compare_price": "₹1495",
            "per_unit": "Flat ₹160 per product",
            "benefits": "Pick any five products\nEvery room in one order\nFree shipping across India",
            "cta_label": "Build this box"
          }
        }
      ]
    }
  ]
}
{% endschema %}