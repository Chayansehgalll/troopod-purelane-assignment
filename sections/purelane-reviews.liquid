{% comment %}
  ============================================================================
  PURELANE — REVIEWS RAIL SECTION
  ============================================================================
  Auto-scrolling review marquee. Reviews are merchant-editable via blocks.
  Track is duplicated so the marquee loops seamlessly.
{% endcomment %}

{{ 'purelane-reviews.css' | asset_url | stylesheet_tag }}
<script src="{{ 'purelane-animations.js' | asset_url }}" defer></script>

{%- liquid
  assign kicker = section.settings.kicker
  assign rating_value = section.settings.rating_value
  assign rating_count_text = section.settings.rating_count_text
  assign homes_count_text = section.settings.homes_count_text
  assign review_blocks = section.blocks
-%}

<section
  id="reviews"
  class="pl-section pl-revband"
  aria-labelledby="pl-reviews-heading"
>
  <div class="pl-wrap">
    <div class="pl-revhead pl-rv">
      {%- if kicker != blank -%}
        <span class="pl-kicker" id="pl-reviews-heading">{{ kicker }}</span>
      {%- endif -%}

      {%- if rating_value != blank -%}
        <span class="pl-agg">
          <span class="pl-st" aria-hidden="true">★★★★★</span>
          <b>{{ rating_value }}</b>
          {%- if rating_count_text != blank -%}
            {{ rating_count_text }}
          {%- endif -%}
        </span>
      {%- endif -%}

      {%- if homes_count_text != blank -%}
        <span class="pl-agg">
          {{ homes_count_text | replace: '[b]', '<b>' | replace: '[/b]', '</b>' }}
        </span>
      {%- endif -%}
    </div>
  </div>

  {%- if review_blocks.size > 0 -%}
    <div class="pl-revrail pl-marquee pl-rv" aria-label="Customer reviews">
      <div class="pl-marquee-track">
        {%- comment -%} Render blocks twice for seamless infinite loop {%- endcomment -%}
        {%- for pass in (1..2) -%}
          {%- for block in review_blocks -%}
            <article
              class="pl-glass-2 pl-rcard"
              {% if pass == 1 %}{{ block.shopify_attributes }}{% endif %}
              {% if pass == 2 %}aria-hidden="true"{% endif %}
            >
              {%- if block.settings.rating > 0 -%}
                <div class="pl-st" aria-label="Rated {{ block.settings.rating }} out of 5">
                  {%- for i in (1..block.settings.rating) -%}★{%- endfor -%}
                </div>
              {%- endif -%}

              {%- if block.settings.title != blank -%}
                <h5>{{ block.settings.title }}</h5>
              {%- endif -%}

              {%- if block.settings.body != blank -%}
                <p>{{ block.settings.body }}</p>
              {%- endif -%}

              <div class="pl-who">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="m5 13 4 4L19 7"/>
                </svg>
                {%- if block.settings.author != blank -%}
                  <b>{{ block.settings.author }}</b>
                {%- endif -%}
                {%- if block.settings.product_context != blank -%}
                  <span>· {{ block.settings.product_context }}</span>
                {%- endif -%}
              </div>
            </article>
          {%- endfor -%}
        {%- endfor -%}
      </div>
    </div>
  {%- else -%}
    <div class="pl-wrap">
      <div style="text-align: center; padding: 40px; color: var(--pl-paper-3);">
        <p style="font-size: 14px;">Add review blocks in the section settings to display them here.</p>
      </div>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Purelane Reviews",
  "tag": "section",
  "class": "pl-reviews-wrap",
  "settings": [
    {
      "type": "header",
      "content": "Header"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker label",
      "default": "That's what they said"
    },
    {
      "type": "text",
      "id": "rating_value",
      "label": "Rating value",
      "default": "4.8"
    },
    {
      "type": "text",
      "id": "rating_count_text",
      "label": "Rating count text",
      "default": "from 8,000+ reviews"
    },
    {
      "type": "text",
      "id": "homes_count_text",
      "label": "Homes count text",
      "default": "Loved by [b]12 lakh+[/b] homes",
      "info": "Use [b]...[/b] to bold a portion"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "limit": 20,
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "label": "Star rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "text",
          "id": "title",
          "label": "Review title",
          "default": "Works like a charm"
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "Review body",
          "default": "A finally-an-eco-option that cleans as well as the chemical detergent I used for years, and it smells better."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author name",
          "default": "Anita"
        },
        {
          "type": "text",
          "id": "product_context",
          "label": "Product context",
          "info": "e.g. 'Laundry detergent' — shown after the author name",
          "default": "Laundry detergent"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane Reviews",
      "blocks": [
        {
          "type": "review",
          "settings": {
            "rating": 5,
            "title": "Works like a charm",
            "body": "Finally an eco option that cleans as well as the chemical detergent I used for years, and it smells better.",
            "author": "Anita",
            "product_context": "Laundry detergent"
          }
        },
        {
          "type": "review",
          "settings": {
            "rating": 5,
            "title": "Best dishwash ever",
            "body": "Our old dishwash left my help with dry, cracked skin. That stopped completely after we switched.",
            "author": "Priya",
            "product_context": "Dishwash gel"
          }
        },
        {
          "type": "review",
          "settings": {
            "rating": 5,
            "title": "Great product, great packaging",
            "body": "Very soft on hands with a lovely fragrance, and it feels good to be using far less plastic.",
            "author": "Sunita",
            "product_context": "Liquid handwash"
          }
        },
        {
          "type": "review",
          "settings": {
            "rating": 5,
            "title": "Dog friendly",
            "body": "We switched because chemical floor cleaners were setting off my dog's allergies. No reactions since.",
            "author": "Rohit S.",
            "product_context": "Floor cleaner"
          }
        },
        {
          "type": "review",
          "settings": {
            "rating": 5,
            "title": "Sparkling taps again",
            "body": "Hard water had ruined our bathroom fittings. Two sprays and the scale wipes straight off, no scrubbing.",
            "author": "Verified buyer",
            "product_context": "Tap cleaner"
          }
        }
      ]
    }
  ]
}
{% endschema %}