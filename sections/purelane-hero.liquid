{% comment %}
  ============================================================================
  PURELANE — HERO SECTION
  ============================================================================
  Displays the main hero with:
    - Animated headline + subheading
    - Two CTA buttons
    - Product carousel (blocks: 1, 2, or 3 products per slide)
    - Badge rail (desktop) + badge strip (mobile)

  All content merchant-editable via schema settings and blocks.
{% endcomment %}

{{ 'purelane-hero.css' | asset_url | stylesheet_tag }}
<script src="{{ 'purelane-animations.js' | asset_url }}" defer></script>

{%- liquid
  assign heading = section.settings.heading
  assign heading_accent = section.settings.heading_accent
  assign subheading = section.settings.subheading
  assign cta_primary_label = section.settings.cta_primary_label
  assign cta_primary_url = section.settings.cta_primary_url
  assign cta_secondary_label = section.settings.cta_secondary_label
  assign cta_secondary_url = section.settings.cta_secondary_url
-%}

<section
  class="pl-section pl-hero"
  aria-label="{{ section.settings.aria_label | default: 'Hero' | escape }}"
>
  <div class="pl-hero-grid">

    {%- comment -%} Desktop badge rail (right edge) {%- endcomment -%}
    {%- assign badge_blocks = section.blocks | where: 'type', 'badge' -%}
    {%- if badge_blocks.size > 0 -%}
      <aside class="pl-hero-badges pl-glass-2" aria-label="Product promises">
        {%- for block in badge_blocks -%}
          <div class="pl-hero-badge" {{ block.shopify_attributes }}>
            <span class="pl-bi">
              {%- render 'purelane-badge-icon', icon: block.settings.icon -%}
            </span>
            <span>{{ block.settings.label | newline_to_br }}</span>
          </div>
        {%- endfor -%}
      </aside>
    {%- endif -%}

    {%- comment -%} Copy block (left side) {%- endcomment -%}
    <div class="pl-hero-copy">
      {%- if heading != blank -%}
        <h1 class="pl-d1 pl-rv pl-in">
          {{ heading }}
          {%- if heading_accent != blank -%}
            <br><span class="pl-lime">{{ heading_accent }}</span>
          {%- endif -%}
        </h1>
      {%- endif -%}

      <div class="pl-rule pl-rv pl-rv-d1">
        <i></i>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/>
          <path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/>
        </svg>
        <i></i>
      </div>

      {%- if subheading != blank -%}
        <p class="pl-lede pl-rv pl-rv-d2">{{ subheading }}</p>
      {%- endif -%}

      {%- if cta_primary_label != blank or cta_secondary_label != blank -%}
        <div class="pl-hero-cta pl-rv pl-rv-d3">
          {%- if cta_primary_label != blank -%}
            <a class="pl-btn pl-btn-primary" href="{{ cta_primary_url | default: '#' }}">
              {{ cta_primary_label }}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h13m-5-6 6 6-6 6"/>
              </svg>
            </a>
          {%- endif -%}
          {%- if cta_secondary_label != blank -%}
            <a class="pl-btn pl-btn-ghost" href="{{ cta_secondary_url | default: '#' }}">
              {{ cta_secondary_label }}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- comment -%} Mobile badge strip {%- endcomment -%}
      {%- if badge_blocks.size > 0 -%}
        <div class="pl-hero-badgestrip pl-rv pl-rv-d4">
          {%- for block in badge_blocks -%}
            <div class="pl-glass-2">
              {%- render 'purelane-badge-icon', icon: block.settings.icon -%}
              {{ block.settings.label | replace: '<br>', ' ' | strip_html }}
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    {%- comment -%} Product stage carousel {%- endcomment -%}
    {%- assign slide_blocks = section.blocks | where: 'type', 'slide' -%}
    {%- if slide_blocks.size > 0 -%}
      <div class="pl-hero-prod">
        <div class="pl-hero-stage" data-pl-interval="{{ section.settings.carousel_interval | default: 3800 }}">
          {%- for block in slide_blocks -%}
            {%- assign slide_index = forloop.index -%}
            {%- assign products_in_slide = 0 -%}
            {%- if block.settings.product_1 != blank %}{% assign products_in_slide = products_in_slide | plus: 1 %}{% endif -%}
            {%- if block.settings.product_2 != blank %}{% assign products_in_slide = products_in_slide | plus: 1 %}{% endif -%}
            {%- if block.settings.product_3 != blank %}{% assign products_in_slide = products_in_slide | plus: 1 %}{% endif -%}

            <div
              class="pl-hslide pl-hs{{ products_in_slide }}{% if forloop.first %} pl-on{% endif %}"
              data-n="{{ slide_index }}"
              {{ block.shopify_attributes }}
            >
              {%- if block.settings.product_1 != blank -%}
                {%- render 'purelane-hero-product', product: block.settings.product_1, class: 'pl-a pl-d1-hp' -%}
              {%- endif -%}
              {%- if block.settings.product_2 != blank -%}
                {%- render 'purelane-hero-product', product: block.settings.product_2, class: 'pl-b pl-d2-hp' -%}
              {%- endif -%}
              {%- if block.settings.product_3 != blank -%}
                {%- render 'purelane-hero-product', product: block.settings.product_3, class: 'pl-c pl-d3-hp' -%}
              {%- endif -%}

              {%- if block.settings.price_label != blank -%}
                <div class="pl-glass-2 pl-ptag">
                  <span class="pl-lbl">{{ block.settings.price_label }}</span>
                  <span class="pl-val">
                    <strong>{{ block.settings.price }}</strong>
                    {%- if block.settings.compare_price != blank -%}
                      <s>{{ block.settings.compare_price }}</s>
                    {%- endif -%}
                  </span>
                  {%- if block.settings.discount_label != blank -%}
                    <span class="pl-cut">{{ block.settings.discount_label }}</span>
                  {%- endif -%}
                </div>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>

        {%- if slide_blocks.size > 1 -%}
          <div class="pl-hdots" role="tablist" aria-label="Product carousel">
            {%- for block in slide_blocks -%}
              <button
                type="button"
                class="{% if forloop.first %}pl-on{% endif %}"
                aria-label="Show slide {{ forloop.index }}"
              ></button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

  </div>
</section>

{% schema %}
{
  "name": "Purelane Hero",
  "tag": "section",
  "class": "pl-hero-wrap",
  "settings": [
    {
      "type": "header",
      "content": "Copy"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Clean That"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Heading accent (highlighted)",
      "default": "Lasts",
      "info": "Displayed on its own line in accent colour"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Homecare that works on the toughest grime, made from plants. Kind to your home, your family and the world outside it."
    },
    {
      "type": "text",
      "id": "aria_label",
      "label": "ARIA label (for screen readers)",
      "default": "Hero"
    },
    {
      "type": "header",
      "content": "Call to action buttons"
    },
    {
      "type": "text",
      "id": "cta_primary_label",
      "label": "Primary button label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "cta_primary_url",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "cta_secondary_label",
      "label": "Secondary button label",
      "default": "How it works"
    },
    {
      "type": "url",
      "id": "cta_secondary_url",
      "label": "Secondary button link"
    },
    {
      "type": "header",
      "content": "Carousel"
    },
    {
      "type": "range",
      "id": "carousel_interval",
      "label": "Auto-advance interval",
      "min": 2000,
      "max": 8000,
      "step": 200,
      "unit": "ms",
      "default": 3800
    }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Badge (trust marker)",
      "limit": 3,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "leaf", "label": "Leaf (plant-based)" },
            { "value": "shield", "label": "Shield (safe)" },
            { "value": "no", "label": "No / prohibit" },
            { "value": "heart", "label": "Heart" }
          ],
          "default": "leaf"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "info": "Use <br> for line break",
          "default": "Plant<br>powered"
        }
      ]
    },
    {
      "type": "slide",
      "name": "Carousel slide",
      "limit": 5,
      "settings": [
        {
          "type": "product",
          "id": "product_1",
          "label": "Product 1"
        },
        {
          "type": "product",
          "id": "product_2",
          "label": "Product 2 (optional)"
        },
        {
          "type": "product",
          "id": "product_3",
          "label": "Product 3 (optional)"
        },
        {
          "type": "text",
          "id": "price_label",
          "label": "Price label",
          "default": "Single bottle"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price",
          "default": "₹200"
        },
        {
          "type": "text",
          "id": "compare_price",
          "label": "Compare-at price",
          "default": "₹299"
        },
        {
          "type": "text",
          "id": "discount_label",
          "label": "Discount label",
          "default": "33% off"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane Hero",
      "blocks": [
        {
          "type": "badge",
          "settings": {
            "icon": "leaf",
            "label": "Plant<br>powered"
          }
        },
        {
          "type": "badge",
          "settings": {
            "icon": "shield",
            "label": "Safe for<br>kids & pets"
          }
        },
        {
          "type": "badge",
          "settings": {
            "icon": "no",
            "label": "Zero harsh<br>chemicals"
          }
        },
        {
          "type": "slide",
          "settings": {
            "price_label": "Single bottle",
            "price": "₹200",
            "compare_price": "₹299",
            "discount_label": "33% off"
          }
        },
        {
          "type": "slide",
          "settings": {
            "price_label": "Any 2 products",
            "price": "₹349",
            "compare_price": "₹598",
            "discount_label": "Save ₹249"
          }
        },
        {
          "type": "slide",
          "settings": {
            "price_label": "Any 3 products",
            "price": "₹499",
            "compare_price": "₹897",
            "discount_label": "Save ₹398"
          }
        }
      ]
    }
  ]
}
{% endschema %}