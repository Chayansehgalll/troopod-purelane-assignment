{% comment %}
  ============================================================================
  PURELANE — SHOP / PRODUCT GRID SECTION
  ============================================================================
  Displays a merchant-editable product grid pulled from a real Shopify
  collection. Handles sold out, no image, and long titles automatically.
{% endcomment %}

{{ 'purelane-shop.css' | asset_url | stylesheet_tag }}
<script src="{{ 'purelane-animations.js' | asset_url }}" defer></script>

{%- liquid
  assign collection = section.settings.collection
  assign product_limit = section.settings.product_limit | default: 8
  assign heading = section.settings.heading | default: 'Loved by 30,000 homes'
  assign kicker = section.settings.kicker | default: 'Bestsellers'
-%}

<section
  id="shop"
  class="pl-section pl-shop"
  aria-labelledby="pl-shop-heading"
>
  <div class="pl-wrap">

    {%- comment -%} Section header {%- endcomment -%}
    <div class="pl-shop-head pl-rv">
      {%- if kicker != blank -%}
        <span class="pl-kicker">{{ kicker }}</span>
      {%- endif -%}
      <h2 class="pl-d2" id="pl-shop-heading" style="margin-top: 12px;">
        {{ heading }}
      </h2>
      <div class="pl-rule" style="margin: 0 auto; justify-content: center; max-width: 240px;">
        <i style="background: linear-gradient(90deg, transparent, rgba(75,58,143,.34));"></i>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="width:16px;height:16px;color:var(--pl-accent);">
          <path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/>
          <path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/>
        </svg>
        <i style="background: linear-gradient(90deg, rgba(75,58,143,.34), transparent);"></i>
      </div>
    </div>

    {%- comment -%} Product grid {%- endcomment -%}
    {%- if collection != blank and collection.products.size > 0 -%}
      <div
        class="pl-shelf"
        role="list"
        aria-label="Products"
      >
        {%- assign delays = 'pl-rv-d1,pl-rv-d2,pl-rv-d3,pl-rv-d4' | split: ',' -%}
        {%- for product in collection.products limit: product_limit -%}
          {%- assign delay = delays[forloop.index0 | modulo: 4] -%}
          <div role="listitem">
            {%- render 'purelane-product-card',
              product: product,
              reveal_delay: delay,
              lazy: true
            -%}
          </div>
        {%- endfor -%}
      </div>

    {%- else -%}
      {%- comment -%} Editor placeholder when no collection selected {%- endcomment -%}
      <div style="text-align: center; padding: 40px; color: var(--pl-paper-3);">
        <p style="font-size: 14px;">Select a collection in the section settings to display products here.</p>
      </div>
    {%- endif -%}

  </div>
</section>

{%- comment -%} AJAX Add to Cart {%- endcomment -%}
<script>
(function () {
  function initATC(root) {
    root = root || document;
    root.querySelectorAll('.pl-atc:not([data-pl-atc-init])').forEach(function (btn) {
      btn.dataset.plAtcInit = '1';
      btn.addEventListener('click', function () {
        var variantId = btn.dataset.variantId;
        if (!variantId) return;

        var originalText = btn.textContent.trim();
        btn.disabled = true;
        btn.textContent = 'Adding…';

        fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id: variantId, quantity: 1 })
        })
        .then(function (r) { return r.json(); })
        .then(function () {
          btn.textContent = 'Added ✓';
          fetch('/cart.js')
            .then(function (r) { return r.json(); })
            .then(function (cart) {
              var bubble = document.querySelector('.cart-count-bubble span');
              if (bubble) bubble.textContent = cart.item_count;
            });
          setTimeout(function () {
            btn.textContent = originalText;
            btn.disabled = false;
          }, 2000);
        })
        .catch(function () {
          btn.textContent = 'Error — try again';
          setTimeout(function () {
            btn.textContent = originalText;
            btn.disabled = false;
          }, 2000);
        });
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function () { initATC(); });
  } else {
    initATC();
  }

  if (window.Shopify && Shopify.designMode) {
    document.addEventListener('shopify:section:load', function (e) {
      initATC(e.target);
    });
  }
})();
</script>

{% schema %}
{
  "name": "Purelane Shop",
  "tag": "section",
  "class": "pl-shop-wrap",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker label",
      "default": "Bestsellers"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Loved by 30,000 homes"
    },
    {
      "type": "header",
      "content": "Products"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Select the collection to display products from"
    },
    {
      "type": "range",
      "id": "product_limit",
      "label": "Number of products",
      "min": 4,
      "max": 12,
      "step": 2,
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "Purelane Shop"
    }
  ]
}
{% endschema %}