{% comment %}
  ============================================================================
  PURELANE — BEST SELLING COMBOS SECTION
  ============================================================================
  Horizontal scroll rail of merchant-editable combo cards. Each block is
  one combo with up to 3 products, benefit captions, pricing, and CTA.
{% endcomment %}

{{ 'purelane-combos.css' | asset_url | stylesheet_tag }}
<script src="{{ 'purelane-animations.js' | asset_url }}" defer></script>

{%- liquid
  assign kicker = section.settings.kicker
  assign heading = section.settings.heading
  assign lede = section.settings.lede
  assign swipe_hint = section.settings.swipe_hint
  assign rail_note = section.settings.rail_note
  assign combo_blocks = section.blocks
-%}

<section
  id="combos"
  class="pl-section pl-combos"
  aria-labelledby="pl-combos-heading"
>
  <div class="pl-wrap">

    <div class="pl-combos-head pl-rv">
      {%- if kicker != blank -%}
        <span class="pl-kicker">{{ kicker }}</span>
      {%- endif -%}
      {%- if heading != blank -%}
        <h2 class="pl-d2" id="pl-combos-heading">{{ heading }}</h2>
      {%- endif -%}
      <div class="pl-rule" style="margin: 0 auto; justify-content: center; max-width: 240px;">
        <i style="background: linear-gradient(90deg, transparent, rgba(75,58,143,.34));"></i>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="width:16px;height:16px;color:var(--pl-accent);">
          <path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/>
          <path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/>
        </svg>
        <i style="background: linear-gradient(90deg, rgba(75,58,143,.34), transparent);"></i>
      </div>
      {%- if lede != blank -%}
        <p class="pl-lede">{{ lede }}</p>
      {%- endif -%}
    </div>

    {%- if combo_blocks.size > 0 -%}
      <div class="pl-comborail pl-rv" role="list" aria-label="Product combos">
        {%- for block in combo_blocks -%}
          {%- liquid
            assign product_count = 0
            if block.settings.product_1 != blank
              assign product_count = product_count | plus: 1
            endif
            if block.settings.product_2 != blank
              assign product_count = product_count | plus: 1
            endif
            if block.settings.product_3 != blank
              assign product_count = product_count | plus: 1
            endif

            assign card_classes = 'pl-glass pl-combo'
            if block.settings.is_featured
              assign card_classes = card_classes | append: ' pl-combo--featured'
            endif
          -%}

          <article class="{{ card_classes }}" role="listitem" {{ block.shopify_attributes }}>
            <div class="pl-combo-tray">
              {%- if block.settings.save_label != blank -%}
                <span class="pl-combo-save">{{ block.settings.save_label }}</span>
              {%- endif -%}
              {%- if block.settings.flag_label != blank -%}
                <span class="pl-combo-flag">{{ block.settings.flag_label }}</span>
              {%- endif -%}

              <div class="pl-stack">
                {%- if block.settings.product_1 != blank or block.settings.caption_1 != blank -%}
                  {%- render 'purelane-combo-stack-item',
                    product: block.settings.product_1,
                    caption: block.settings.caption_1
                  -%}
                {%- endif -%}

                {%- if product_count > 1 -%}
                  <span class="pl-stack-plus" aria-hidden="true">+</span>
                  {%- render 'purelane-combo-stack-item',
                    product: block.settings.product_2,
                    caption: block.settings.caption_2
                  -%}
                {%- endif -%}

                {%- if product_count > 2 -%}
                  <span class="pl-stack-plus" aria-hidden="true">+</span>
                  {%- render 'purelane-combo-stack-item',
                    product: block.settings.product_3,
                    caption: block.settings.caption_3
                  -%}
                {%- endif -%}
              </div>
            </div>

            <div class="pl-combo-body">
              {%- if block.settings.title != blank -%}
                <h3>{{ block.settings.title }}</h3>
              {%- endif -%}

              {%- if block.settings.product_count_label != blank -%}
                <div class="pl-combo-cnt">{{ block.settings.product_count_label }}</div>
              {%- endif -%}

              {%- if block.settings.description != blank -%}
                <p class="pl-combo-inc">{{ block.settings.description }}</p>
              {%- endif -%}

              <div class="pl-combo-prow">
                {%- if block.settings.price != blank -%}
                  <strong>{{ block.settings.price }}</strong>
                {%- endif -%}
                {%- if block.settings.compare_price != blank -%}
                  <s>{{ block.settings.compare_price }}</s>
                {%- endif -%}
                {%- if block.settings.savings_label != blank -%}
                  <em>{{ block.settings.savings_label }}</em>
                {%- endif -%}
              </div>

              {%- if block.settings.fine_print != blank -%}
                <div class="pl-combo-fine">{{ block.settings.fine_print }}</div>
              {%- endif -%}

              {%- if block.settings.cta_label != blank -%}
                {%- assign btn_class = 'pl-btn pl-btn-ghost' -%}
                {%- if block.settings.is_featured -%}
                  {%- assign btn_class = 'pl-btn pl-btn-primary' -%}
                {%- endif -%}
                <a class="{{ btn_class }}" href="{{ block.settings.cta_url | default: '#' }}">
                  {{ block.settings.cta_label }}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M5 12h13m-5-6 6 6-6 6"/>
                  </svg>
                </a>
              {%- endif -%}
            </div>
          </article>
        {%- endfor -%}
      </div>

      {%- if swipe_hint != blank -%}
        <div class="pl-swipecue" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h13m-5-6 6 6-6 6"/>
          </svg>
          {{ swipe_hint }}
        </div>
      {%- endif -%}

      {%- if rail_note != blank -%}
        <p class="pl-railnote">{{ rail_note }}</p>
      {%- endif -%}

    {%- else -%}
      <div style="text-align: center; padding: 40px; color: var(--pl-paper-3);">
        <p style="font-size: 14px;">Add combo blocks in the section settings to display them here.</p>
      </div>
    {%- endif -%}

  </div>
</section>

